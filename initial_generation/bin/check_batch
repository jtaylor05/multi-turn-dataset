#!/usr/bin/env python

import anthropic
import sys

if len(sys.argv) != 2:
    print("Usage: python check_batch.py <batch_id>")
    sys.exit(1)

client = anthropic.Anthropic()

batch = client.messages.batches.retrieve(sys.argv[1])

print(f"Batch ID: {batch.id}")
print(f"Status: {batch.processing_status}")
print(f"Completed at: {batch.ended_at}")
print(f"Output File ID: {batch.results_url}")
print(f"Whole Batch Object: {batch}")